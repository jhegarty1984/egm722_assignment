## --- GIS Data Folders ---
# Ignore all raw and processed spatial data
Spatial_Data/
assignment_output_data/

# --- Sentinel-2 Specific ---
# Ignore .SAFE structures and JPEG2000 files
*.SAFE/
*.jp2

# --- Raster and Vector Extensions ---
# Catches any loose spatial files in the root or subfolders
*.tif
*.tiff
*.shp
*.shx
*.dbf
*.prj
*.sbn
*.sbx
*.cpg
*.qpj

# --- Python Environment & OS ---
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.env
.venv/
env/
venv/
.env

# Windows thumbnail cache
Thumbs.db
